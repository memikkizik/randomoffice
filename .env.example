# RandomOffice Configuration Example
# Copy this file to .env and adjust variables as needed.
# DO NOT commit real secrets or production credentials to source control.

# Server settings
HOST=127.0.0.1
PORT=8000
DEBUG=false

# Performance & Security Limits
MAX_UPLOAD_SIZE_BYTES=33554432
MAX_RANGE_EXPANSION_CELLS=10000

# File monitoring
MONITORED_DIRECTORY=monitored
UPLOADS_DIRECTORY=uploads

